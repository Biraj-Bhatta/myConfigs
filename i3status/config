general {
    colors = true
    interval = 5
    separator = "  "
    color_good     = "#00ff00"
    color_degraded = "#FFFF00"
    color_bad      = "#FF0000"
}

order += "wireless _first_"
order += "battery all"
order += "tztime date"
order += "tztime clock"

wireless _first_ {
    format_up   = "󰤨 %essid %quality"
    format_down = "󰤭 down"
}

battery all {
    format = "%status %percentage"
    format_down = "󰂑 N/A"
    status_chr  = "󰂄"
    status_bat  = "󰁹"
    status_full = "󰁹"
    status_idle = "󰁹"
    status_unk  = "󰂑"
    integer_battery_capacity = true
    low_threshold = 30
    threshold_type = percentage
}

tztime date {
    format = "󰃭 %a %d %b"
}

tztime clock {
    format = "󰥔 %H:%M"
}
